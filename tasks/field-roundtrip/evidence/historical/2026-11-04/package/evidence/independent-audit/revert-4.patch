+/** Restores declared model dates without interpreting strings inside other fields. */
+export function restoreModelDates<T extends Record<string, unknown>>(
+	options: BetterAuthOptions,
+	modelName: "user" | "session",
+	data: T,
+): T {
+	const fields = getFields(options, modelName, "transport");
+	const result = { ...data };
+	for (const [key, field] of Object.entries(fields)) {
+		const value = data[key];
+		if (field.type === "date" && typeof value === "string") {
+			Object.assign(result, { [key]: new Date(value) });
+		}
+	}
+	return result;
+}
